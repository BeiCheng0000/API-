# ============================================
# API 自动化测试平台 - 环境变量配置模板
# ============================================
# 使用方法：复制此文件为 .env 并填入实际值
#   cp .env.example .env
#
# ⚠️ .env 文件已被 .gitignore 排除，不会被提交到代码仓库
# ⚠️ 请勿将真实的密码和 Token 提交到版本控制中
# ============================================

# ---------- 数据库配置 ----------

# MySQL 数据库密码（可选，使用数据库功能时需要）
DB_PASSWORD=

# MongoDB 数据库密码（可选，使用数据库功能时需要）
MONGO_PASSWORD=

# ---------- API 认证配置 ----------

# API 认证 Token（各环境通用，可在 env.yaml 中按环境覆盖）
API_TOKEN=

# ---------- 邮件配置 ----------

# 邮件服务密码（可选，用于测试报告通知）
EMAIL_PASSWORD=

# ---------- Web 应用配置 ----------

# Flask Secret Key（生产环境必须修改为随机字符串）
# 生成方式：python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=api_automation_platform_secret_key_2024

# ---------- 环境地址配置 ----------

# 生产环境 API 地址（可选，覆盖 env.yaml 中 prod 环境的 base_url）
# ⚠️ 建议通过此变量注入生产环境地址，不要将真实地址提交到代码仓库
# PROD_BASE_URL=https://your-real-prod-api.com

# ---------- 域名获取配置 ----------

# 域名获取登录邮箱
DOMAIN_CREDENTIALS_LOGIN=

# 域名获取登录密码
DOMAIN_CREDENTIALS_PASSWORD=

# 域名获取隧道名称
DOMAIN_TUNNEL_NAME=api自动化平台

# 域名获取API地址
DOMAIN_BASE_URL=http://localhost:9200

# ---------- 测试配置 ----------

# 测试环境覆盖（可选，覆盖 config.yaml 中的 env.current 值）
# TEST_ENV=dev
